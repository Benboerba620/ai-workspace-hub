filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("inbox")
        - file.inFolder("output/research")
        - file.inFolder("output/screen")
        - file.inFolder("output/pod2wiki")
        - file.inFolder("output/daily-watch")
        - file.inFolder("workspace/monitoring")
        - file.inFolder("wiki/sources")
formulas:
  status: if(read_status, read_status, "未读")
  status_icon: if(read_status == "已读", "✅", if(read_status == "精读", "⭐", if(read_status == "跳过", "⏭️", "📄")))
  category: if(/(^|\/)inbox\//.matches(file.path), "📥 Inbox", if(/output\/research/.matches(file.path), "🔬 研究", if(/output\/screen/.matches(file.path), "🔍 筛选", if(/output\/pod2wiki/.matches(file.path), "🎙️ Podcast", if(/(output\/daily-watch|workspace\/monitoring)/.matches(file.path), "📊 日报监控", if(/wiki\/sources/.matches(file.path), "📚 Sources", "🗂️ 其他"))))))
  days_old: (now() - file.ctime).days.round(0)
properties:
  read_status:
    displayName: 阅读状态
  formula.status:
    displayName: 状态
  formula.category:
    displayName: 类别
  formula.days_old:
    displayName: 入库天数
views:
  - type: table
    name: 🎯 今日看什么
    filters:
      and:
        - (now() - file.ctime).days <= 3
        - formula.status != "已读"
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
    limit: 20
  - type: table
    name: 📥 Inbox（未读）
    filters:
      and:
        - file.inFolder("inbox")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 🔬 研究
    filters:
      and:
        - file.inFolder("output/research")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 🔍 筛选
    filters:
      and:
        - file.inFolder("output/screen")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 30
  - type: table
    name: 🎙️ Podcast
    filters:
      and:
        - file.inFolder("output/pod2wiki")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 📊 日报监控
    filters:
      or:
        - file.inFolder("output/daily-watch")
        - file.inFolder("workspace/monitoring")
    order:
      - file.name
      - formula.category
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 14
  - type: table
    name: 📚 Sources（近30天未读）
    filters:
      and:
        - file.inFolder("wiki/sources")
        - formula.status == "未读"
        - (now() - file.ctime).days <= 30
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: ⭐ 精读清单
    filters:
      and:
        - read_status == "精读"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: ✅ 最近已读
    filters:
      and:
        - read_status == "已读"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 30
