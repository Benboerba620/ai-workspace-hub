filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("inbox")
        - file.inFolder("output/research")
        - file.inFolder("output/screen")
        - file.inFolder("output/pod2wiki")
        - file.inFolder("output/daily-watch")
        - file.inFolder("workspace/monitoring")
        - file.inFolder("wiki/sources")
formulas:
  status: if(read_status == "已读" || read_status == "精读" || read_status == "跳过", read_status, "未读")
  status_icon: if(read_status == "已读", "✅", if(read_status == "精读", "⭐", if(read_status == "跳过", "⏭️", "📄")))
  category: if(/(^|\/)inbox\//.matches(file.path), "📥 Inbox", if(/output\/research/.matches(file.path), "🔬 研究", if(/output\/screen/.matches(file.path), "🔍 筛选", if(/output\/pod2wiki/.matches(file.path), "🎙️ Podcast", if(/(output\/daily-watch|workspace\/monitoring)/.matches(file.path), "📊 日报监控", if(/wiki\/sources/.matches(file.path), "📚 Sources", "🗂️ 其他"))))))
  content_date: if(source_published_at, date(source_published_at), if(published_at, date(published_at), if(publish_time, date(publish_time), if(date, date(date), if(/^\d{4}-\d{2}-\d{2}/.matches(file.basename), date(file.basename.slice(0, 10)), if(created_at, date(created_at), if(created, date(created), file.ctime)))))))
  days_old: (now() - formula.content_date).days.floor()
properties:
  read_status:
    displayName: 阅读标记（点击填写）
  formula.status:
    displayName: 状态
  formula.category:
    displayName: 类别
  formula.content_date:
    displayName: 资料日期
  formula.days_old:
    displayName: 距今天数
views:
  - type: table
    name: 🎯 今日看什么
    filters:
      and:
        - formula.days_old >= 0
        - formula.days_old <= 3
        - formula.status != "已读"
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.category
      - formula.content_date
      - formula.days_old
    sort:
      - property: formula.content_date
        direction: DESC
    limit: 20
  - type: table
    name: 📥 Inbox（未读）
    filters:
      and:
        - file.inFolder("inbox")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.content_date
      - formula.days_old
    sort:
      - property: formula.content_date
        direction: DESC
  - type: table
    name: 🔬 研究
    filters:
      and:
        - file.inFolder("output/research")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.content_date
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 🔍 筛选
    filters:
      and:
        - file.inFolder("output/screen")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.content_date
    sort:
      - property: formula.content_date
        direction: DESC
    limit: 30
  - type: table
    name: 🎙️ Podcast
    filters:
      and:
        - file.inFolder("output/pod2wiki")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.content_date
      - formula.days_old
    sort:
      - property: formula.content_date
        direction: DESC
  - type: table
    name: 📊 日报监控
    filters:
      or:
        - file.inFolder("output/daily-watch")
        - file.inFolder("workspace/monitoring")
    order:
      - file.name
      - read_status
      - formula.category
      - formula.content_date
    sort:
      - property: formula.content_date
        direction: DESC
    limit: 14
  - type: table
    name: 📚 Sources（近30天未读）
    filters:
      and:
        - file.inFolder("wiki/sources")
        - formula.status == "未读"
        - formula.days_old >= 0
        - formula.days_old <= 30
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.content_date
      - formula.days_old
    sort:
      - property: formula.content_date
        direction: DESC
  - type: table
    name: ⭐ 精读清单
    filters:
      and:
        - read_status == "精读"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.category
      - formula.content_date
      - formula.days_old
    sort:
      - property: formula.content_date
        direction: DESC
  - type: table
    name: ✅ 最近已读
    filters:
      and:
        - read_status == "已读"
    order:
      - formula.status_icon
      - file.name
      - read_status
      - formula.category
      - formula.content_date
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 30
