{
  "schema_version": 2,
  "hub_version": "0.6.0",
  "ownership": {
    "managed": [
      "system/**",
      "tools/**",
      "workspace/.hub-state.json",
      "START-HERE.md",
      "requirements.txt",
      "requirements.lock",
      "requirements-pdf.txt"
    ],
    "user_owned": [
      "config/**",
      "daily-watchlist-reports/**",
      "evidence/**",
      "hypothesis/**",
      "inbox/**",
      "monitoring/**",
      "output/**",
      "portfolio/**",
      "wiki/concepts/**",
      "wiki/entities/**",
      "wiki/explorations/**",
      "wiki/raw/**",
      "wiki/sources/**",
      "wiki/rules.md",
      "wiki/false-beliefs.md",
      "workspace/patterns/**",
      "workspace/meta/**",
      "workspace/review-queue.md"
    ],
    "mixed": [
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      "wiki/_schema.md",
      "workspace/research-profile.md",
      "workspace/workspace-config.md"
    ]
  },
  "upgrade_policy": {
    "managed": "Hub upgrades may replace these files after showing a diff.",
    "user_owned": "Hub upgrades must never overwrite these files.",
    "mixed": "Hub upgrades must preserve local changes and require an explicit merge."
  },
  "migrations": {
    "additive_directories": [
      "evidence",
      "workspace/patterns"
    ],
    "additive_files": [
      {
        "source": "evidence/README.md",
        "target": "evidence/README.md"
      },
      {
        "source": "system/templates/review-queue.md",
        "target": "workspace/review-queue.md"
      },
      {
        "source": "system/templates/research-profile.md",
        "target": "workspace/research-profile.md"
      },
      {
        "source": "wiki/explorations/_index.md",
        "target": "wiki/explorations/_index.md"
      },
      {
        "source": "workspace/patterns/_index.md",
        "target": "workspace/patterns/_index.md"
      },
      {
        "source": "workspace/patterns/_template.md",
        "target": "workspace/patterns/_template.md"
      },
      {
        "source": "wiki/rules.md",
        "target": "wiki/rules.md"
      },
      {
        "source": "wiki/false-beliefs.md",
        "target": "wiki/false-beliefs.md"
      }
    ]
  }
}
